[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/Menus/end_of_act.gd" id="1_script"]
[ext_resource type="FontFile" path="res://Assets/Fonts/Rye-Regular.ttf" id="2_font"]
[ext_resource type="AudioStream" path="res://Assets/SoundEffects/WoodenBlock.wav" id="3_sound"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_clear"]
bg_color = Color(0, 0, 0, 0)

[sub_resource type="Theme" id="Theme_end_act"]
default_font = ExtResource("2_font")
Button/font_sizes/font_size = 36
Button/colors/font_color = Color(1, 1, 1, 1)
Button/colors/font_focus_color = Color(1, 1, 1, 1)
Button/colors/font_hover_color = Color(0.9098039, 0.4, 0.2901961, 1)
Button/colors/font_pressed_color = Color(0.8784314, 0.34901962, 0.23921569, 1)
Button/styles/normal = SubResource("StyleBoxFlat_clear")
Button/styles/hover = SubResource("StyleBoxFlat_clear")
Button/styles/pressed = SubResource("StyleBoxFlat_clear")
Button/styles/focus = SubResource("StyleBoxFlat_clear")

[node name="EndOfAct" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_end_act")
script = ExtResource("1_script")

[node name="CanvasLayer" type="CanvasLayer" parent="."]
layer = 20

[node name="Background" type="ColorRect" parent="CanvasLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 1)

[node name="Title" type="Label" parent="CanvasLayer"]
anchors_preset = -1
anchor_top = 0.3
anchor_right = 1.0
anchor_bottom = 0.3
offset_top = -50.0
offset_bottom = 50.0
grow_horizontal = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 64
text = "End of Act 1"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Reputation" type="Label" parent="CanvasLayer"]
anchors_preset = -1
anchor_top = 0.45
anchor_right = 1.0
anchor_bottom = 0.45
offset_top = -40.0
offset_bottom = 40.0
grow_horizontal = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 48
text = "Reputation: 0"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="CanvasLayer"]
anchors_preset = -1
anchor_left = 0.1
anchor_top = 1.0
anchor_right = 0.9
anchor_bottom = 1.0
offset_top = -140.0
offset_bottom = -60.0
grow_vertical = 0
theme = SubResource("Theme_end_act")
theme_override_constants/separation = 100
alignment = 1

[node name="Continue" type="Button" parent="CanvasLayer/Buttons"]
layout_mode = 2
text = "Continue"

[node name="MainMenu" type="Button" parent="CanvasLayer/Buttons"]
layout_mode = 2
text = "Main Menu"

[node name="WoodenBlock" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3_sound")
bus = &"sfx"

[connection signal="pressed" from="CanvasLayer/Buttons/Continue" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="CanvasLayer/Buttons/MainMenu" to="." method="_on_main_menu_pressed"]
